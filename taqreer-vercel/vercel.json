{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/\u0627\u0644\u0634\u0639\u0627\u0631\u0627\u062a/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/webhook/telegram.js": {
      "includeFiles": "public/**/*.png|public/**/*.jpg|public/**/*.JPG|public/**/*.ttf|public/**/*.html|public/**/*.css|public/**/*.js",
      "maxDuration": 60
    },
    "api/send-generated-pdf.js": {
      "maxDuration": 30
    },
    "api/send-pdf.js": {
      "maxDuration": 30
    },
    "api/send-existing-pdf.js": {
      "maxDuration": 30
    },
    "api/setup.js": {
      "maxDuration": 30
    },
    "api/upload-inquiry.js": {
      "maxDuration": 10
    },
    "api/inquiry.js": {
      "maxDuration": 10
    },
    "api/logs.js": {
      "maxDuration": 10
    },
    "api/report/[...slug].js": {
      "maxDuration": 10
    },
    "api/user/[chatId]/index.js": {
      "maxDuration": 10
    },
    "api/user/[chatId]/package.js": {
      "maxDuration": 10
    }
  }
}